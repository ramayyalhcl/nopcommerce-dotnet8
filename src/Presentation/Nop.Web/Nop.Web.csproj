<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Nop.Web</RootNamespace>
    <AssemblyName>Nop.Web</AssemblyName>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    
    <!-- Ensure all content files are copied to publish directory for IIS deployment -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\Nop.Data\Nop.Data.csproj" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" />
    <ProjectReference Include="..\Nop.Web.Framework\Nop.Web.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- 
    IIS Deployment: Ensure all required folders are copied to publish output
    The SDK includes these as Content by default, we just ensure CopyToPublishDirectory is set
  -->
  <ItemGroup>
    <!-- App_Data: Localization, Installation SQL scripts -->
    <Content Update="App_Data\**\*" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="App_Data\Settings.txt" />
    
    <!-- Views: Razor .cshtml files for runtime compilation -->
    <Content Update="Views\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
    
    <!-- Content: CSS, images, fonts -->
    <Content Update="Content\**\*" CopyToPublishDirectory="PreserveNewest" />
    
    <!-- Scripts: JavaScript files -->
    <Content Update="Scripts\**\*" CopyToPublishDirectory="PreserveNewest" />
    
    <!-- Themes: Theme views, configs, assets -->
    <Content Update="Themes\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
